# ---- Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Groq - free hosted open-source LLM like Llama (free key: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Ollama - 100% free local LLM (https://ollama.com -> `ollama pull llama3.2`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Order in which providers are tried (fallback). Options: gemini, groq, ollama, mock
LLM_PROVIDER_ORDER=gemini,groq,ollama

# Optional tuning
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_HISTORY_TURNS=10
MAX_CONTEXT_CHARS=12000
MAX_UPLOAD_MB=20
